# Copy this file to .env and adjust values for your machine.

# Execution mode: "local" (process the CSV directly, no HDFS needed)
# or "hdfs" (upload to and read from HDFS via PySpark).
TRAFFIC_MODE=local

# Path to the source dataset (local filesystem), used in both modes.
TRAFFIC_CSV_PATH=Traffic.csv

# --- HDFS mode settings (only used when TRAFFIC_MODE=hdfs) ---
# Must match fs.default.name / fs.defaultFS in $HADOOP_HOME/etc/hadoop/core-site.xml
HDFS_NAMENODE_HOST=127.0.0.1
HDFS_NAMENODE_PORT=9000
HDFS_BASE_DIR=/user/traffic

# --- Java / Hadoop environment ---
# Point this at a Java 8 JDK (Spark 3.5.x + Hadoop 3.4.3 are verified against Java 8 here).
JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-1.8.jdk/Contents/Home
HADOOP_HOME=/Users/aditi/Downloads/hadoop-3.4.3

# Spark tuning (safe defaults for a laptop)
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
